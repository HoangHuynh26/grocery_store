PORT=5000
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh

# ==============================================================================
# NEON SERVERLESS POSTGRESQL (https://neon.tech)
# ==============================================================================
# Điền chuỗi kết nối Neon của bạn vào đây (hỗ trợ cả Direct và Connection Pooling endpoint):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_DATA_DIR=./data/pgdata

# ==============================================================================
# BẢO MẬT & JWT TOKENS
# ==============================================================================
JWT_SECRET=grocery_pos_secret_key_change_in_production_2026
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=grocery_pos_refresh_secret_key_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# ==============================================================================
# CORS & PUBLIC URLS (Hỗ trợ chạy đồng thời cả Local và Public)
# ==============================================================================
CORS_ORIGIN=http://localhost:5173,https://grocery-store-app.vercel.app
CLIENT_URL=https://grocery-store-app.vercel.app
PUBLIC_FRONTEND_URL=https://grocery-store-app.vercel.app
PUBLIC_BACKEND_URL=https://grocery-pos-backend.onrender.com

# Các dịch vụ bên ngoài (Tùy chọn)
GEMINI_API_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ==============================================================================
# BIẾN MÔI TRƯỜNG CHO FRONTEND (Vercel Production & Local Development)
# ==============================================================================

# Khi chạy Local Development:
# Để trống để Vite tự động proxy qua http://localhost:5000 theo vite.config.js
# VITE_API_URL=/api

# Khi triển khai lên Vercel Production:
# Điền địa chỉ Web Service Render của bạn (hỗ trợ cả có hoặc không có /api ở cuối)
VITE_API_URL=https://grocery-pos-backend.onrender.com/api

# Tùy chọn: URL kết nối Realtime Socket.IO Gateway (mặc định tự động trích xuất từ VITE_API_URL)
# VITE_SOCKET_URL=https://grocery-pos-backend.onrender.com
